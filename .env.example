# Server-only GitHub token used to fetch the contribution calendar.
GITHUB_TOKEN=

# Server-only Spotify credentials. Authorize with user-read-recently-played.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Must match the redirect URI registered in your Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
